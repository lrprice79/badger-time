{
  "name": "@purple-brock/time",
  "version": "1.0.0",
  "description": "Lightweight date engine and formatter — no moment, no date-fns.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:bundle && npm run build:strip-types",
    "build:publish": "npm run build && npm run build:obfuscate",
    "build:strip-types": "node scripts/strip-dts-comments.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "build:bundle": "rollup -c",
    "build:obfuscate": "node scripts/obfuscate.mjs",
    "prepublishOnly": "npm run build",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:cet": "TZ=Europe/Berlin vitest run --config vitest.cet.config.mts",
    "test:ny": "TZ=America/New_York vitest run --config vitest.ny.config.mts",
    "test:la": "TZ=America/Los_Angeles vitest run --config vitest.la.config.mts"
  },
  "keywords": [
    "date",
    "datetime",
    "formatter",
    "intl",
    "lightweight"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^2.1.9",
    "javascript-obfuscator": "^4.1.1",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
